# 数据库（Docker 内部连接，无需修改）
DATABASE_URL=postgresql+asyncpg://pm_admin:changeme@pm-postgres:5432/pm_system
REDIS_URL=redis://pm-redis:6379/0

# JWT（必须修改为随机字符串）
JWT_SECRET=change-this-to-a-random-secret-key

# AI 配置（至少填一个 Key）
AI_DEFAULT_PROVIDER=deepseek
AI_DEEPSEEK_API_KEY=sk-your-deepseek-key
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_DEEPSEEK_MODEL=deepseek-chat
AI_QWEN_API_KEY=sk-your-qwen-key
AI_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_QWEN_MODEL=qwen-max

# 文件上传
UPLOAD_DIR=/data/uploads
