# ============================================================
# 帮助手册网站 - 环境变量配置
# 复制此文件为 .env 并修改相应值
# cp .env.example .env
# ============================================================

# JWT 签名密钥（必须修改！至少 32 个字符的随机字符串）
JWT_SECRET=please-change-this-to-a-random-string-at-least-32-chars

# Spring 配置文件（prod=生产环境）
SPRING_PROFILES_ACTIVE=prod

# JVM 内存参数
JAVA_OPTS=-Xmx512m -Xms256m
